{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "ios:sync": "vite build && npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@distube/ytdl-core": "^4.16.12",
    "@google/genai": "^2.4.0",
    "@saavn-labs/sdk": "^0.1.5",
    "@tailwindcss/vite": "^4.1.14",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "dew-ytdl": "^1.0.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "hls.js": "^1.7.2",
    "lucide-react": "^0.546.0",
    "lz-string": "^1.5.0",
    "motion": "^12.23.24",
    "play-dl": "^1.9.7",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "saavnapi": "^1.0.1",
    "soundcloud-downloader": "^1.0.0",
    "soundcloud-scraper": "^5.0.3",
    "vite": "^6.2.3",
    "youtube-dl-exec": "^3.1.15",
    "youtubei.js": "^18.0.0",
    "yt-search": "^2.13.1",
    "ytmp3-scrap": "^1.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/express": "^4.17.21",
    "@types/lz-string": "^1.5.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
